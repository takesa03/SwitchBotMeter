<Window x:Class="SwitchBotMeter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
        Title="SwitchBot Meter Monitor" Height="800" Width="1300"
        MinHeight="500" MinWidth="800" Icon="SwitchBotMeter.ico">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 左パネル（デバイス一覧 + デバイス情報） -->
        <Grid Grid.Column="0" Background="{StaticResource PanelBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- デバイス一覧セクション -->
            <StackPanel Grid.Row="0" Margin="10">
                <TextBlock Text="デバイス一覧" FontSize="14" FontWeight="Bold" Margin="0,0,0,10"/>
                <Button Name="ScanButton" Padding="5" Click="ScanButton_Click"
                       Content="{Binding IsScanning, Converter={StaticResource BoolToTextConverter}, ConverterParameter='スキャン停止;スキャン開始'}"/>
            </StackPanel>

            <ListBox Grid.Row="1" Name="DeviceListBox" Margin="10"
                     ItemsSource="{Binding Devices}"
                     SelectedItem="{Binding SelectedDevice}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <CheckBox IsChecked="{Binding ShowOnGraph}" VerticalAlignment="Center" Margin="0,0,6,0"
                                     Checked="GraphCheckBox_Changed" Unchecked="GraphCheckBox_Changed"/>
                            <TextBlock Text="{Binding DisplayName}" Foreground="{Binding GraphColorBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- ステータスセクション -->
            <StackPanel Grid.Row="2" Margin="10" Orientation="Vertical">
                <TextBlock Name="StatusText" Text="{Binding StatusMessage}"
                          FontSize="11" TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}"/>
            </StackPanel>

            <!-- デバイス情報セクション -->
            <Grid Grid.Row="3" Background="{StaticResource SectionBrush}" Margin="0,5,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="デバイス情報" FontSize="12" FontWeight="Bold"
                          Margin="10,10,10,5"/>

                <StackPanel Grid.Row="1" Margin="10,0,10,10">
                    <TextBlock Text="別名:" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                    <TextBox Name="AliasTextBox" Text="{Binding SelectedDevice.Alias, UpdateSourceTrigger=PropertyChanged}"
                             FontSize="13" Margin="0,0,0,8" LostFocus="AliasTextBox_LostFocus"/>

                    <TextBlock Text="グラフ表示色:" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,2,0,8" HorizontalAlignment="Left">
                        <Button Name="CurrentColorButton" Width="26" Height="26" Padding="0"
                               Background="{Binding SelectedDevice.GraphColorBrush}"
                               Click="CurrentColorButton_Click"/>
                        <Popup Name="ColorPalettePopup" PlacementTarget="{Binding ElementName=CurrentColorButton}"
                              Placement="Bottom" StaysOpen="False" AllowsTransparency="True">
                            <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}"
                                   BorderThickness="1" Padding="6">
                                <ItemsControl ItemsSource="{Binding DevicePaletteSwatches}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel Width="112"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Width="24" Height="24" Margin="2" Padding="0"
                                                   Background="{Binding Brush}" Tag="{Binding Index}"
                                                   Click="PaletteColorButton_Click"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>
                        </Popup>
                    </StackPanel>

                    <TextBlock Text="アドレス:" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                    <TextBlock Name="AddressText" Text="{Binding SelectedDevice.BluetoothAddress}"
                              FontFamily="Courier New" FontSize="13" Margin="0,0,0,8"/>

                    <TextBlock Text="タイプ:" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                    <TextBlock Name="TypeText" Text="{Binding SelectedDevice.DeviceType}"
                              FontSize="13" Margin="0,0,0,8"/>

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="温度" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock Name="TemperatureText"
                                      Text="{Binding SelectedDevice.LastTemperature, StringFormat={}{0:F1}℃, TargetNullValue=-}"
                                      FontSize="13"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1">
                            <TextBlock Text="湿度" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock Name="HumidityText"
                                      Text="{Binding SelectedDevice.LastHumidity, StringFormat={}{0}%, TargetNullValue=-}"
                                      FontSize="13"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="バッテリー" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock Name="BatteryText"
                                      Text="{Binding SelectedDevice.LastBattery, StringFormat={}{0}%, TargetNullValue=-}"
                                      FontSize="13"/>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="最終受信:" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                    <TextBlock Name="LastSeenText" Text="{Binding SelectedDevice.LastSeen, StringFormat=yyyy/MM/dd HH:mm:ss}"
                              FontSize="13" Margin="0,0,0,8"/>
                </StackPanel>

                <GroupBox Grid.Row="2" Header="バックグラウンド監視" Margin="10,5,10,10" Padding="8">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,2">
                            <CheckBox Name="MonitorCheckBox" Content="このデバイスを監視"
                                     IsChecked="{Binding SelectedDevice.IsMonitored}" FontSize="10"
                                     VerticalAlignment="Center"
                                     Checked="MonitorCheckBox_Changed" Unchecked="MonitorCheckBox_Changed"/>
                            <TextBlock Text="{Binding MonitoredDeviceName}" FontSize="10" Margin="6,0,0,0"
                                      VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}"/>
                        </StackPanel>

                        <TextBlock Text="出力ファイル:" Margin="0,8,0,2" FontSize="9" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Name="OutputPathBox" Height="20" FontSize="9"
                                    Text="{Binding OutputFilePath, UpdateSourceTrigger=PropertyChanged}"/>
                            <Button Grid.Column="1" Content="..." Width="24" Height="20" Margin="4,0,0,0"
                                   Padding="0" FontSize="9" Click="BrowseOutputFileButton_Click"/>
                        </Grid>

                        <Button Name="MonitorStartButton" Padding="3" Margin="0,8,0,2" FontSize="9" Click="MonitorStartButton_Click"
                               Content="{Binding IsMonitoringActive, Converter={StaticResource BoolToTextConverter}, ConverterParameter='監視停止;監視開始'}"/>
                    </StackPanel>
                </GroupBox>

                <GroupBox Grid.Row="3" Header="デバイスデータ保存先" Margin="10,0,10,10" Padding="8">
                    <StackPanel>
                        <TextBlock Text="別名・グラフ表示色・履歴CSVをまとめて保存するフォルダ" FontSize="9"
                                  Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,4"/>
                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Name="DeviceDataDirectoryBox" Height="20" FontSize="9"
                                    IsReadOnly="True" Text="{Binding DeviceDataDirectory, Mode=OneWay}"/>
                            <Button Grid.Column="1" Content="..." Width="24" Height="20" Margin="4,0,0,0"
                                   Padding="0" FontSize="9" Click="BrowseDeviceDataFolderButton_Click"/>
                        </Grid>
                    </StackPanel>
                </GroupBox>
            </Grid>
        </Grid>

        <!-- 中央パネル（グラフ表示 + デバッグログ） -->
        <Grid Grid.Column="1" Name="CenterGrid" Background="{StaticResource BackgroundBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Name="DebugLogRow" Height="200"/>
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" Margin="10">
                <ComboBox Name="TimeRangeComboBox" DockPanel.Dock="Right" Width="100" FontSize="11"
                         SelectedIndex="0" SelectionChanged="TimeRangeComboBox_SelectionChanged">
                    <ComboBoxItem Content="30分" Tag="ThirtyMinutes"/>
                    <ComboBoxItem Content="1時間" Tag="OneHour"/>
                    <ComboBoxItem Content="2時間" Tag="TwoHours"/>
                    <ComboBoxItem Content="4時間" Tag="FourHours"/>
                    <ComboBoxItem Content="6時間" Tag="SixHours"/>
                    <ComboBoxItem Content="12時間" Tag="TwelveHours"/>
                    <ComboBoxItem Content="1日" Tag="OneDay"/>
                    <ComboBoxItem Content="1週間" Tag="OneWeek"/>
                    <ComboBoxItem Content="1ヶ月" Tag="OneMonth"/>
                    <ComboBoxItem Content="半年" Tag="SixMonths"/>
                    <ComboBoxItem Content="1年" Tag="OneYear"/>
                </ComboBox>
                <Button Name="GraphPauseButton" DockPanel.Dock="Right" Width="90" Margin="8,0,0,0"
                       Content="{Binding IsGraphPaused, Converter={StaticResource BoolToTextConverter}, ConverterParameter='再開;一時停止'}"
                       Click="GraphPauseButton_Click"/>
                <TextBlock Text="グラフ表示" FontSize="14" FontWeight="Bold"
                          Foreground="{StaticResource TextSecondaryBrush}"/>
            </DockPanel>

            <!-- 温度グラフ -->
            <Grid Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <DockPanel Grid.Row="0" Margin="10,0,10,0">
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                        <TextBlock Text="下限:" VerticalAlignment="Center" Margin="0,0,4,0"
                                  Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBox Width="50" VerticalContentAlignment="Center"
                                Text="{Binding TemperatureAxisMin, UpdateSourceTrigger=LostFocus}"/>
                        <StackPanel Orientation="Vertical" Margin="1,0,0,0" VerticalAlignment="Center">
                            <RepeatButton Content="▲" Tag="TemperatureAxisMin" Width="20" Height="17" FontSize="9" Foreground="Black" FontWeight="Bold" Padding="0" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Click="AxisUpButton_Click"/>
                            <RepeatButton Content="▼" Tag="TemperatureAxisMin" Width="20" Height="17" FontSize="9" Foreground="Black" FontWeight="Bold" Padding="0" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Click="AxisDownButton_Click"/>
                        </StackPanel>
                        <TextBlock Text="上限:" VerticalAlignment="Center" Margin="10,0,4,0"
                                  Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBox Width="50" VerticalContentAlignment="Center"
                                Text="{Binding TemperatureAxisMax, UpdateSourceTrigger=LostFocus}"/>
                        <StackPanel Orientation="Vertical" Margin="1,0,0,0" VerticalAlignment="Center">
                            <RepeatButton Content="▲" Tag="TemperatureAxisMax" Width="20" Height="17" FontSize="9" Foreground="Black" FontWeight="Bold" Padding="0" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Click="AxisUpButton_Click"/>
                            <RepeatButton Content="▼" Tag="TemperatureAxisMax" Width="20" Height="17" FontSize="9" Foreground="Black" FontWeight="Bold" Padding="0" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Click="AxisDownButton_Click"/>
                        </StackPanel>
                    </StackPanel>
                    <TextBlock Text="温度" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                </DockPanel>
                <lvc:CartesianChart Grid.Row="1" Margin="10,0,10,5" Background="{StaticResource PanelBrush}"
                                   Series="{Binding TemperatureSeries}" XAxes="{Binding TemperatureXAxes}"
                                   YAxes="{Binding TemperatureYAxes}"
                                   AnimationsSpeed="{Binding GraphAnimationsSpeed}"
                                   LegendTextPaint="{Binding LegendTextPaint}"/>
            </Grid>

            <!-- 湿度グラフ -->
            <Grid Grid.Row="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <DockPanel Grid.Row="0" Margin="10,5,10,0">
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                        <TextBlock Text="下限:" VerticalAlignment="Center" Margin="0,0,4,0"
                                  Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBox Width="50" VerticalContentAlignment="Center"
                                Text="{Binding HumidityAxisMin, UpdateSourceTrigger=LostFocus}"/>
                        <StackPanel Orientation="Vertical" Margin="1,0,0,0" VerticalAlignment="Center">
                            <RepeatButton Content="▲" Tag="HumidityAxisMin" Width="20" Height="17" FontSize="9" Foreground="Black" FontWeight="Bold" Padding="0" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Click="AxisUpButton_Click"/>
                            <RepeatButton Content="▼" Tag="HumidityAxisMin" Width="20" Height="17" FontSize="9" Foreground="Black" FontWeight="Bold" Padding="0" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Click="AxisDownButton_Click"/>
                        </StackPanel>
                        <TextBlock Text="上限:" VerticalAlignment="Center" Margin="10,0,4,0"
                                  Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBox Width="50" VerticalContentAlignment="Center"
                                Text="{Binding HumidityAxisMax, UpdateSourceTrigger=LostFocus}"/>
                        <StackPanel Orientation="Vertical" Margin="1,0,0,0" VerticalAlignment="Center">
                            <RepeatButton Content="▲" Tag="HumidityAxisMax" Width="20" Height="17" FontSize="9" Foreground="Black" FontWeight="Bold" Padding="0" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Click="AxisUpButton_Click"/>
                            <RepeatButton Content="▼" Tag="HumidityAxisMax" Width="20" Height="17" FontSize="9" Foreground="Black" FontWeight="Bold" Padding="0" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Click="AxisDownButton_Click"/>
                        </StackPanel>
                    </StackPanel>
                    <TextBlock Text="湿度" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                </DockPanel>
                <lvc:CartesianChart Grid.Row="1" Margin="10,0,10,5" Background="{StaticResource PanelBrush}"
                                   Series="{Binding HumiditySeries}" XAxes="{Binding HumidityXAxes}"
                                   YAxes="{Binding HumidityYAxes}"
                                   AnimationsSpeed="{Binding GraphAnimationsSpeed}"
                                   LegendTextPaint="{Binding LegendTextPaint}"/>
            </Grid>

            <!-- 常時表示の折りたたみ切り替えバー -->
            <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="10,10,10,0" HorizontalAlignment="Left">
                <Button Name="ToggleLogButton" Content="▼ スキャン受信状況" Padding="6,2" FontSize="10"
                       Click="ToggleLogButton_Click"/>
            </StackPanel>

            <!-- 折りたたみ対象: ログ本体 -->
            <Grid Grid.Row="4" Name="DebugLogPanel" Margin="10,5,10,10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                    <TextBox Name="DebugLogTextBox" Text="{Binding DebugLog, Mode=OneWay}"
                             IsReadOnly="True" TextWrapping="NoWrap" FontFamily="Consolas" FontSize="10"
                             Background="{StaticResource PanelBrush}" BorderThickness="0"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                             TextChanged="DebugLogTextBox_TextChanged"/>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
